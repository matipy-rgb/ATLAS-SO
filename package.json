{
    "name": "atlas-so",
    "version": "0.3.3",
    "private": true,
    "description": "ATLAS SO · centro personal de operaciones",
    "scripts": {
        "mobile:prepare": "node scripts/prepare-mobile.mjs",
        "mobile:init": "npm run mobile:prepare && npx cap add android",
        "mobile:sync": "npm run mobile:prepare && npx cap sync android",
        "mobile:open": "npx cap open android",
        "check": "node scripts/check-project.mjs && node scripts/test-auth-recovery.mjs"
    },
    "dependencies": {
        "@capacitor/android": "8.4.2",
        "@capacitor/core": "8.4.2"
    },
    "devDependencies": {
        "@capacitor/cli": "8.4.2"
    },
    "engines": {
        "node": ">=22"
    }
}
